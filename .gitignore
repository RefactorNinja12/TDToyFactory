# Godot: imported/cached files and C# build output are regenerated by the editor
.godot/
/factory-td/android/
*.translation
mono_crash.*.json

# Local Godot overrides and exported builds
override.cfg
export_presets.cfg
/builds/
*.exe
*.pck

# .NET / IDEs
bin/
obj/
.vs/
*.user
*.suo

# Secrets and machine-local settings (the PixelLab token lives in the PIXELLAB_API_TOKEN
# environment variable, never in a file)
.env
.env.*
*.key
.claude/settings.local.json

# OS clutter
Thumbs.db
Desktop.ini
.DS_Store

# Local headless test probes (never committed)
/factory-td/Scripts/_Test/
/factory-td/Scenes/_Probe.tscn*

# Test run output
TestResults/
